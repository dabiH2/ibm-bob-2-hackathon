{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "execute_command",
        "hooks": [
          {
            "type": "command",
            "command": "python .bob/hooks/release_gate.py",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .bob/hooks/release_gate.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
